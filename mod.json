{
    "geode": "5.11.2",
    "gd": {
        "win": "2.2081",
        "android": "2.2081",
        "mac": "2.2081"
    },
    "id": "stick.deathshake",
    "name": "DeathShake",
    "version": "v1.0.2",
    "developer": "Stick",
    "description": "Camera shake when you crash.",
    "links": {
        "source": "https://github.com/Stickhappy/DeathShake"
    },
    "tags": ["gameplay", "enhancement"],
    "settings": {
        "enabled": {
            "name": "Enabled",
            "description": "Toggle camera shake on death.",
            "type": "bool",
            "default": true
        },
        "speed": {
            "name": "Speed",
            "description": "How fast the shake happens.",
            "type": "float",
            "default": 1.0,
            "min": 0.2,
            "max": 3.0,
            "enable-if": "enabled"
        },
        "intensity": {
            "name": "Intensity",
            "description": "Shake distance in pixels.",
            "type": "float",
            "default": 8.0,
            "min": 1.0,
            "max": 30.0,
            "enable-if": "enabled"
        },
        "rotation": {
            "name": "Rotation",
            "description": "Slight tilt during the shake.",
            "type": "bool",
            "default": true,
            "enable-if": "enabled"
        },
        "practice": {
            "name": "Practice Mode",
            "description": "Allow shake in practice mode.",
            "type": "bool",
            "default": true,
            "enable-if": "enabled"
        }
    }
}
